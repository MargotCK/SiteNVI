{% extends 'base.html.twig' %}

{% block title %}www.nousvousiles.com/boutique/{% endblock %}

{% block body %}
    <section class="container py-5 text-center">

        <h1 class="mb-4">
            www.nousvousiles.com/boutique/
        </h1>

        <div class="mb-4">
            {% if flyer %}
                <img
                    src="{{ flyer.chemin }}"
                    alt="{{ flyer.texteAlternatif ?: 'Flyer des trois boutiques de Nous Vous Îles : NVI Boutik, Afrikrea et SumUp Store' }}"
                    class="img-fluid rounded shadow-sm"
                    style="width: 100%; max-width: 500px; height: auto;"
                >
            {% else %}
                <div class="alert alert-warning">
                    Le flyer des boutiques est temporairement indisponible.
                </div>
            {% endif %}
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-center gap-3">

            <a href="https://www.nviboutik.com"
                class="btn btn-warning"
                target="_blank"
                rel="noopener noreferrer">
                NVI Boutik
            </a>

            <a href="https://www.afrikrea.co/fr/shops/nous-vous-iles/"
                class="btn btn-warning"
                target="_blank"
                rel="noopener noreferrer">
                Afrikrea
            </a>

            <a href="https://nousvousiles.sumupstore.com/"
                class="btn btn-warning"
                target="_blank"
                rel="noopener noreferrer">
                SumUp Store
            </a>

        </div>

    </section>
{% endblock %}