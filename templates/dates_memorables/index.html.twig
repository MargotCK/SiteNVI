{% extends 'base.html.twig' %}

{% block title %}
    {% if contenuEditorial %}
        {{ contenuEditorial.titre }}
    {% else %}
        Dates mémorables
    {% endif %}
{% endblock %}

{% block body %}
<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">

            <h1 class="mb-4 text-center">Dates mémorables</h1>

            {% if contenuEditorial %}

                <article class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5">

                        <h2 class="h3 mb-4 text-center">
                            {{ contenuEditorial.titre }}
                        </h2>

                        {% if contenuEditorial.image %}
                            <div class="text-center mb-4">
                                <img
                                    src="{{ contenuEditorial.image.url }}"
                                    alt="{{ contenuEditorial.image.alt }}"
                                    class="img-fluid rounded"
                                >
                            </div>
                        {% endif %}

                        <div class="fs-5">
                            {{ contenuEditorial.contenu|raw }}
                        </div>

                    </div>
                </article>

            {% else %}

                <div class="alert alert-info text-center">
                    Aucun contenu n’est publié pour le moment dans cette rubrique.
                </div>

            {% endif %}

        </div>
    </div>
</section>
{% endblock %}
