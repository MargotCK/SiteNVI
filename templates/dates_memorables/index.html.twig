{% extends 'base.html.twig' %}

{% block title %}
    {% if contenuEditorial %}
        {{ contenuEditorial.titre }}
    {% else %}
        Dates mémorables
    {% endif %}
{% endblock %}

{% block body %}
<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">

            <h1 class="mb-4 text-center page-title-orange">Dates mémorables</h1>

            {% if contenuEditorial %}

                <article class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5 text-justify">

                        <h2 class="h3 mb-4 text-center page-title-orange">
                            {{ contenuEditorial.titre }}
                        </h2>

                        {% if contenuEditorial.image %}
                            <div class="bg-warning-subtle rounded p-4 mb-5 text-center">
                                <img
                                    src="{{ contenuEditorial.image.chemin }}"
                                    alt="{{ contenuEditorial.image.texteAlternatif ?: contenuEditorial.titre }}"
                                    class="img-fluid rounded shadow-sm editorial-image"
                                >
                            </div>
                        {% endif %}

                        <div class="fs-5 editorial-content">
                            {{ contenuEditorial.contenu|nl2br }}
                        </div>

                    </div>
                </article>

            {% else %}

                <div class="bg-warning-subtle rounded p-4 text-center">
                    <p class="mb-0 fw-bold">
                        Aucun contenu n’est publié pour le moment dans cette rubrique.
                    </p>
                </div>

            {% endif %}

        </div>
    </div>
</section>
{% endblock %}