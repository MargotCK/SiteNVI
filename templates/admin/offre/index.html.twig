{% extends 'base.html.twig' %}

{% block title %}Gestion des offres{% endblock %}

{% block body %}
<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0 page-title-orange">
            Gestion des offres
        </h1>

        <div class="d-flex gap-2">
            <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-secondary">
                Retour au tableau de bord
            </a>

            <a href="{{ path('app_admin_offre_new') }}" class="btn btn-warning">
                Ajouter une offre
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            {% if offres is not empty %}
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Titre</th>
                                <th>Catégorie</th>
                                <th>Publié</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for offre in offres %}
                                <tr>
                                    <td>
                                        {{ offre.titre }}
                                    </td>

                                    <td>
                                        {{ offre.categorieOffre.nom }}
                                    </td>

                                    <td>
                                        {% if offre.actif %}
                                            <span class="badge bg-success">Oui</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Non</span>
                                        {% endif %}
                                    </td>

                                    <td class="text-end">
                                        <a
                                            href="{{ path('app_offre_show', {'slug': offre.slug}) }}"
                                            class="btn btn-sm btn-outline-secondary"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            Voir
                                        </a>

                                        <a
                                            href="{{ path('app_admin_offre_edit', {'id': offre.id}) }}"
                                            class="btn btn-sm btn-warning"
                                        >
                                            Modifier
                                        </a>

                                        <form
                                            method="post"
                                            action="{{ path('app_admin_offre_delete', {'id': offre.id}) }}"
                                            class="d-inline"
                                            onsubmit="return confirm('Supprimer cette offre ?');"
                                        >
                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('delete_offre_' ~ offre.id) }}"
                                            >

                                            <button class="btn btn-sm btn-outline-danger">
                                                Supprimer
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="mb-0 text-center">
                    Aucune offre n’a encore été créée.
                </p>
            {% endif %}

        </div>
    </div>
</section>
{% endblock %}