{% extends 'base.html.twig' %}

{% block title %}Gestion des contenus éditoriaux{% endblock %}

{% block body %}
    <section class="container py-5">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Gestion des contenus éditoriaux</h1>

            <a
                href="{{ path('app_admin_contenu_editorial_new') }}"
                class="btn btn-warning"
            >
                Ajouter un contenu
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Catégorie</th>
                        <th>Image</th>
                        <th>Actif</th>
                        <th>Date de création</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for contenu in contenus %}
                        <tr>
                            <td>{{ contenu.titre }}</td>

                            <td>
                                {{ contenu.categorieContenu.nom }}
                            </td>

                            <td>
                                {% if contenu.image %}
                                    <img
                                        src="{{ contenu.image.chemin }}"
                                        alt="{{ contenu.image.texteAlternatif ?? 'Image du contenu' }}"
                                        style="width: 100px; height: 70px; object-fit: contain;"
                                    >
                                {% else %}
                                    Aucune
                                {% endif %}
                            </td>

                            <td>
                                {% if contenu.actif %}
                                    <span class="badge bg-success">Actif</span>
                                {% else %}
                                    <span class="badge bg-secondary">Inactif</span>
                                {% endif %}
                            </td>

                            <td>
                                {{ contenu.dateCreation|date('d/m/Y H:i') }}
                            </td>

                            <td>
                                <a
                                    href="{{ path('app_admin_contenu_editorial_edit', {'id': contenu.id}) }}"
                                    class="btn btn-sm btn-outline-primary"
                                >
                                    Modifier
                                </a>

                                <form
                                    method="post"
                                    action="{{ path('app_admin_contenu_editorial_delete', {'id': contenu.id}) }}"
                                    class="d-inline"
                                    onsubmit="return confirm('Voulez-vous vraiment supprimer ce contenu éditorial ?');"
                                >
                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('delete' ~ contenu.id) }}"
                                    >

                                    <button
                                        type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                    >
                                        Supprimer
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center">
                                Aucun contenu éditorial.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}