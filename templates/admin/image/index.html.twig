{% extends 'base.html.twig' %}

{% block title %}Gérer les images{% endblock %}

{% block body %}
<section class="container py-5">

    <h1 class="mb-4 text-center">Gérer les images</h1>

    <div class="mb-4 text-center">
        <a href="{{ path('app_admin_image_new') }}" class="btn btn-warning">
            Ajouter une image
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Aperçu</th>
                    <th>Nom du fichier</th>
                    <th>Texte alternatif</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for image in images %}
                    <tr>
                        <td>
                            <img
                                src="{{ image.chemin }}"
                                alt="{{ image.texteAlternatif ?: 'Image NVI' }}"
                                style="width: 100px; height: 70px; object-fit: contain;"
                            >
                        </td>

                        <td>{{ image.nomFichier }}</td>

                        <td>{{ image.texteAlternatif ?: 'Non renseigné' }}</td>

                        <td>
                            <div class="d-flex flex-wrap gap-2">

                                <a
                                    href="{{ image.chemin }}"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="btn btn-outline-primary btn-sm"
                                >
                                    Voir / copier l’URL
                                </a>

                                <a
                                    href="{{ path('app_admin_image_edit', {'id': image.id}) }}"
                                    class="btn btn-outline-secondary btn-sm"
                                >
                                    Modifier
                                </a>

                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center">
                            Aucune image enregistrée.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="text-center mt-4">
        <a href="{{ path('app_admin_dashboard') }}">
            Retour au tableau de bord
        </a>
    </div>

</section>
{% endblock %}