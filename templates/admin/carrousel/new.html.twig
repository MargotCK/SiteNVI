{% extends 'base.html.twig' %}

{% block title %}Ajouter au carrousel{% endblock %}

{% block body %}
    <section class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">

                <h1 class="mb-4 text-center">
                    Ajouter au carrousel
                </h1>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">
                        {{ message }}
                    </div>
                {% endfor %}

                {{ form_start(form) }}

                    <div class="mb-3">
                        {{ form_row(form.image) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.ordreCarrousel) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.actif) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.offre) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.contenuEditorial) }}
                    </div>

                    <button type="submit" class="btn btn-warning w-100">
                        Ajouter au carrousel
                    </button>

                {{ form_end(form) }}

            </div>
        </div>
    </section>
{% endblock %}