{% extends 'base.html.twig' %}

{% block title %}Modifier le carrousel{% endblock %}

{% block body %}
    <section class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">

                <h1 class="mb-4 text-center">
                    Modifier un élément du carrousel
                </h1>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">
                        {{ message }}
                    </div>
                {% endfor %}

                {{ form_start(form) }}

                    <div class="mb-3">
                        {{ form_row(form.image) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.ordreCarrousel) }}
                        {{ form_widget(form.ordreCarrousel) }}

                        <div class="text-danger fw-bold">
                            {{ form_errors(form.ordreCarrousel) }}
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        {{ form_row(form.actif) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.offre) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.contenuEditorial) }}
                    </div>

                    <button type="submit" class="btn btn-warning w-100">
                        Enregistrer les modifications
                    </button>

                {{ form_end(form) }}

                <div class="text-center mt-3">
                    <a href="{{ path('app_admin_carrousel_index') }}">
                        Retour à la liste
                    </a>
                </div>

            </div>
        </div>
    </section>
{% endblock %}