{% extends 'base.html.twig' %}

{% block title %}Événements{% endblock %}

{% block body %}
<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">

            <h1 class="mb-4 text-center page-title-orange">Événements</h1>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5 text-justify">

                    <p class="lead text-center mb-5">
                        Nous Vous Îles propose tout au long de l’année des événements
                        autour de la culture, de la transmission, de la rencontre
                        et du partage.
                    </p>

                    <p>
                        Ces temps forts permettent de faire vivre les cultures d’Outre-mer,
                        de valoriser les langues, les récits, les savoir-faire,
                        les créations et les initiatives portées par l’association.
                    </p>

                    <div class="bg-warning-subtle rounded p-4 mt-5 text-center">
                        <p class="mb-0 fw-bold">
                            Choisissez un événement dans le menu pour découvrir
                            le détail de chaque rendez-vous.
                        </p>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>
{% endblock %}