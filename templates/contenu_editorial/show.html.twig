{% extends 'base.html.twig' %}

{% block title %}
    {{ contenuEditorial.titre }} - Nous Vous Îles
{% endblock %}

{% block meta_description %}
    {{ contenuEditorial.metaDescription ?? contenuEditorial.resume ?? contenuEditorial.titre }}
{% endblock %}

{% block body %}
    <main class="contenu-editorial-page">
        <article class="contenu-editorial-article">

            <h1 class="contenu-editorial-title">
                {{ contenuEditorial.titre }}
            </h1>

            {% if contenuEditorial.image %}
                <div class="contenu-editorial-image-wrapper">
                    <img
                        src="{{ contenuEditorial.image.chemin }}"
                        class="contenu-editorial-image"
                        alt="{{ contenuEditorial.image.texteAlternatif ?? contenuEditorial.titre }}"
                    >
                </div>
            {% endif %}

            {% if contenuEditorial.resume %}
                <p class="contenu-editorial-resume">
                    {{ contenuEditorial.resume }}
                </p>
            {% endif %}

            <div class="contenu-editorial-content">
                {{ contenuEditorial.contenu|raw }}
            </div>

        </article>
    </main>
{% endblock %}