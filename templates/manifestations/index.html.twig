{% extends 'base.html.twig' %}

{% block title %}
    {% if contenuEditorial %}
        {{ contenuEditorial.titre }}
    {% else %}
        Agenda
    {% endif %}
{% endblock %}

{% block body %}
<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">

            <h1 class="mb-2 text-center page-title-orange">Agenda</h1>
            
            {% if contenuEditorial %}

                <article class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5 text-justify">

                        <div class="text-center mb-4">
                            <h2 class="h3 mb-0 page-title-orange">
                                {{ contenuEditorial.titre }}
                            </h2>
                        </div>

                        {% if contenuEditorial.image %}
                            <div class="bg-warning-subtle rounded p-4 mb-5 text-center">
                                <img
                                    src="{{ contenuEditorial.image.chemin }}"
                                    alt="{{ contenuEditorial.image.texteAlternatif ?: contenuEditorial.titre }}"
                                    class="img-fluid rounded shadow-sm editorial-image"
                                >
                            </div>
                        {% endif %}

                        {% if contenuEditorial.contenu %}
                            <div class="editorial-content agenda-content">
                                {% for paragraphe in contenuEditorial.contenu|split("\n\n") %}
                                    {% if paragraphe|trim is not empty %}
                                        <p>{{ paragraphe|trim|nl2br }}</p>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% endif %}

                    </div>
                </article>

            {% else %}

                <div class="bg-warning-subtle rounded p-4 text-center">
                    <p class="mb-0">
                        L’agenda du mois sera bientôt disponible.
                    </p>
                </div>

            {% endif %}

        </div>
    </div>
</section>
{% endblock %}