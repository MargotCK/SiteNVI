{% extends 'base.html.twig' %}

{% block title %}Page introuvable{% endblock %}

{% block body %}
<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 text-center">

            <h1 class="mb-3 page-title-orange">Page introuvable</h1>

            <p class="lead mb-4">
                La page que vous recherchez n’existe pas ou n’est plus disponible.
            </p>

            <div class="bg-warning-subtle rounded p-4 mb-4">
                <p class="mb-0">
                    Le lien utilisé est peut-être incorrect, ou le contenu a été déplacé.
                </p>
            </div>

            <a href="{{ path('app_home') }}" class="btn btn-warning">
                Retour à l’accueil
            </a>

        </div>
    </div>
</section>
{% endblock %}
