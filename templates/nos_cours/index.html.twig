{% extends 'base.html.twig' %}

{% block title %}Nos cours{% endblock %}

{% block body %}
<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">

            <h1 class="mb-4 text-center page-title-orange">Nos cours</h1>

            <p class="lead text-center mb-4">
                Apprendre, créer, transmettre
            </p>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5 text-justify">

                    <p class="lead text-center mb-5">
                        Chez Nous, Vous, Îles – Espace Culturel Outremer, les cours sont pensés
                        comme des espaces d’apprentissage, de transmission et de créativité,
                        ouverts à tous les âges et à tous les niveaux.
                    </p>
                    <div class="bg-warning-subtle rounded p-4 mt-5 text-center">
                        <p class="mb-0 fw-bold">
                            Que vous souhaitiez apprendre, vous perfectionner ou simplement
                            essayer une nouvelle activité, il y a forcément un cours NVI fait pour vous.
                        </p>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>
{% endblock %}